<?xml version="1.0" encoding="UTF-8"?>
<!-- Reference airframe (5-inch, 0.61 kg, 225 mm diagonal). Values: indi_flight/design/ref_airframe_model.md -->
<sdf version='1.9'>
  <model name='quad5in_base'>
    <pose>0 0 0.065 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <inertial>
        <mass>0.566</mass>
        <inertia>
          <ixx>1.022e-03</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.122e-03</iyy>
          <iyz>0</iyz>
          <izz>1.944e-03</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay />
      <visual name="body_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.09 0.04 0.035</size></box></geometry>
        <material><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="arm_visual_0">
        <pose>0 0 0 0 0 0.7853981634</pose>
        <geometry><box><size>0.22486 0.012 0.004</size></box></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="arm_visual_1">
        <pose>0 0 0 0 0 -0.7853981634</pose>
        <geometry><box><size>0.22486 0.012 0.004</size></box></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="base_link_collision_0">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.12 0.12 0.04</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <collision name="leg_0">
        <pose>0.07 0.07 -0.04 0 0 0</pose>
        <geometry>
          <box>
            <size>0.01 0.01 0.04</size>
          </box>
        </geometry>
        <surface>
