# S40 measured-rotor-speed variant: inj_model.params + CA_R_W_MAX = quad5in maxRotVelocity 2700 rad/s
MC_RATE_CTL_TYPE 1
MC_INDI_INJ_AX 1
MC_INDI_INJ_AMP 0
MC_INDI_INJ_TP 10
MC_INDI_INJ_NP 3
MC_INDI_INJ_FMIN 1
MC_INDI_INJ_FMAX 60
MC_INDI_INJ_DLY 20
CA_R_W_MAX 2700
# S47: appended G1 lines from indi_flight/bench/params/quad5in_indi_g1.params (derived G1) and SENS_BAR_AUTOCAL 0; base = indi_flight/results/stage2_s40/pretest_inj/inj_measured_long.params
MC_INDI_G1_R 1757
MC_INDI_G1_P 1640
MC_INDI_G1_Y 205
SENS_BAR_AUTOCAL 0
# S47 yaw spin-up term derived: G2 = G1_Y * J_r/(2 k_m w_h) = 205*5e-6/(2*1.9e-8*999) = 27
MC_INDI_G2_Y 27
