# S40 measured-rotor-speed variant: inj_model.params + CA_R_W_MAX = quad5in maxRotVelocity 2700 rad/s
MC_RATE_CTL_TYPE 1
MC_INDI_INJ_AX 1
MC_INDI_INJ_AMP 0
MC_INDI_INJ_TP 10
MC_INDI_INJ_NP 3
MC_INDI_INJ_FMIN 1
MC_INDI_INJ_FMAX 60
MC_INDI_INJ_DLY 20
CA_R_W_MAX 2700
# quad5in INDI rate-loop effectiveness, derived from CA_* + total gz inertia (base_link + 4 rotor links, parallel axis).
# Two keys: bench/derive_g1.py (results/stage2_s46/derive_g1.md) and independent re-derivation
# (results/stage2_s46/g1_second_key.md). Yaw uses Izz with the rotors' own spin inertia (2.700e-3); without it 222.
# Append to every INDI params file of the reference airframe; supersedes the S44/S45 hand values (1756/1599/215).
MC_INDI_G1_R 1757
MC_INDI_G1_P 1640
MC_INDI_G1_Y 205
