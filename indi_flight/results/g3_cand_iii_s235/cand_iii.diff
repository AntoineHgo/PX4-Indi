+void IndiRateControl::updateRateIntegral(const Vector3f &rate_error, const float dt, const bool frozen)
+{
+	if ((_integral_corner_hz <= 0.f) || (_integral_limit <= 0.f)) {
+		_rate_integral.zero();
+		return;
+	}
+
+	if (frozen) {
+		return;
+	}
+
+	for (int i = 0; i < 3; i++) {
+		float error = rate_error(i);
+
+		// no further growth in the direction the allocator cannot deliver
+		if (_saturation_positive(i)) {
+			error = math::min(error, 0.f);
+		}
+
+		if (_saturation_negative(i)) {
+			error = math::max(error, 0.f);
+		}
+
+		const float corner = math::min(2.f * M_PI_F * _integral_corner_hz, kMaxIntegralCornerRatio * _gain_k(i));
+		_rate_integral(i) = math::constrain(_rate_integral(i) + corner * _gain_k(i) * error / _g1(i) * dt,
+						    -_integral_limit, _integral_limit);
+	}
+}
