+namespace
+{
+
+constexpr float kIntegralCornerHz = 0.5f;
+constexpr float kIntegralLimit = 0.2f;
+
+IndiRateControl makeIntegralController(float corner_hz = kIntegralCornerHz, float limit = kIntegralLimit)
+{
+	IndiRateControl ctrl = makeController();
+	ctrl.setActuatorBlendTimeConstant(0.f); // the measured torque alone, no integral action from the blend
+	ctrl.setRateIntegral(corner_hz, limit);
+	return ctrl;
+}
+
+/// Roll loop on the measured torque with a constant torque loss (weak motor): the plant produces gap less torque than
+/// commanded and the measurement sees that too. Returns the rate after the run, the mean of the last second.
+float runWeakMotorLoop(IndiRateControl &ctrl, float gap, float duration_s)
+{
+	RollPlant plant;
+	float command = 0.f;
+	float rate_sum = 0.f;
+	int rate_count = 0;
+	const int steps = static_cast<int>(duration_s / kDt);
+
+	for (int i = 0; i < steps; i++) {
+		const Vector3f measured(plant.torque() - gap, 0.f, 0.f);
+		ctrl.setMeasuredTorque(measured, true);
+		const Vector3f torque = ctrl.update(Vector3f(plant.rate(), 0.f, 0.f), Vector3f(),
+						    Vector3f(plant.accelFiltered(), 0.f, 0.f), Vector3f(command, 0.f, 0.f), kDt, false);
+		command = torque(0);
+		plant.step(command, -kG1True * gap);
+
+		if (i >= steps - static_cast<int>(1.f / kDt)) {
+			rate_sum += plant.rate();
+			rate_count++;
+		}
+	}
+
+	return rate_sum / static_cast<float>(rate_count);
+}
+
+/// constant roll rate error (default 0.1 rad/s) for n cycles, no measured acceleration, returns the last output
+Vector3f runRateError(IndiRateControl &ctrl, int n, bool landed, bool maybe_landed, float error = 0.1f)
+{
+	Vector3f torque;
+
+	for (int i = 0; i < n; i++) {
+		torque = ctrl.update(Vector3f(), Vector3f(error, 0.f, 0.f), Vector3f(), Vector3f(), kDt, landed, maybe_landed);
+	}
+
+	return torque;
+}
+
+} // namespace
+
+TEST(IndiRateIntegralTest, WeakMotorLoopRemovesSteadyError)
+{
+	const float gap = 0.08f;
+
+	// without the integrator the measured torque feedback leaves a steady rate error: 0.08 * 100 / 20 = 0.4 rad/s
+	IndiRateControl without = makeIntegralController(0.f, 0.f);
+	EXPECT_GT(fabsf(runWeakMotorLoop(without, gap, 12.f)), 0.3f);
+
+	IndiRateControl with = makeIntegralController();
+	EXPECT_LT(fabsf(runWeakMotorLoop(with, gap, 12.f)), 0.02f);
+	EXPECT_NEAR(with.getRateIntegral()(0), gap, 0.005f);
+}
+
+TEST(IndiRateIntegralTest, HeldWhileAllocatorSaturatesInTheErrorDirection)
+{
+	IndiRateControl ctrl = makeIntegralController();
+	ctrl.setSaturationStatus(Vector3<bool>(true, false, false), Vector3<bool>());
+	runRateError(ctrl, 400, false, false, 0.1f); // positive error, positive saturation
+	EXPECT_EQ(ctrl.getRateIntegral()(0), 0.f);
+
+	runRateError(ctrl, 400, false, false, -0.1f); // opposite direction is free
+	EXPECT_LT(ctrl.getRateIntegral()(0), -0.01f);
+
+	ctrl.reset();
+	ctrl.setSaturationStatus(Vector3<bool>(), Vector3<bool>(true, false, false));
+	runRateError(ctrl, 400, false, false, -0.1f);
+	EXPECT_EQ(ctrl.getRateIntegral()(0), 0.f);
+
+	runRateError(ctrl, 400, false, false, 0.1f);
+	EXPECT_GT(ctrl.getRateIntegral()(0), 0.01f);
+
+	ctrl.setSaturationStatus(Vector3<bool>(), Vector3<bool>()); // released
+	const float held = ctrl.getRateIntegral()(0);
+	runRateError(ctrl, 100, false, false, 0.1f);
+	EXPECT_GT(ctrl.getRateIntegral()(0), held);
+}
+
+TEST(IndiRateIntegralTest, FrozenOnGroundAndNotAppliedWhileLanded)
+{
+	IndiRateControl ctrl = makeIntegralController();
+	runRateError(ctrl, 400, false, false);
+	const float held = ctrl.getRateIntegral()(0);
+	ASSERT_GT(held, 0.01f);
+
+	// maybe landed: held, still applied (nu = K e + G1 i)
+	Vector3f torque = runRateError(ctrl, 400, false, true);
+	EXPECT_EQ(ctrl.getRateIntegral()(0), held);
+	EXPECT_NEAR(ctrl.getNu()(0), 2.f + kG1True * held, 1e-3f);
+	(void)torque;
+
+	// landed: held, not applied, nu is the proportional term only
+	runRateError(ctrl, 400, true, true);
+	EXPECT_EQ(ctrl.getRateIntegral()(0), held);
+	EXPECT_NEAR(ctrl.getNu()(0), 2.f, 1e-3f);
+
+	// back in flight it is applied again and grows
+	runRateError(ctrl, 100, false, false);
+	EXPECT_GT(ctrl.getRateIntegral()(0), held);
+}
+
+TEST(IndiRateIntegralTest, ResetAtArmingClearsIntegral)
+{
+	IndiRateControl ctrl = makeIntegralController();
+	runRateError(ctrl, 400, false, false);
+	ASSERT_GT(ctrl.getRateIntegral()(0), 0.01f);
+
+	ctrl.reset();
+	EXPECT_EQ(ctrl.getRateIntegral(), Vector3f());
+	const Vector3f torque = runRateError(ctrl, 1, false, false);
+	EXPECT_NEAR(torque(0), 2.f / kG1True, 1e-3f); // proportional term only, no leftover integral
+}
+
+TEST(IndiRateIntegralTest, BoundedByLimitOnEveryAxis)
+{
+	IndiRateControl ctrl = makeIntegralController();
+	Vector3f torque;
+
+	for (int i = 0; i < 4000; i++) { // 10 s of a constant error on all axes, opposite signs
+		torque = ctrl.update(Vector3f(), Vector3f(1.5f, -1.5f, 1.5f), Vector3f(), Vector3f(), kDt, false);
+	}
+
+	EXPECT_FLOAT_EQ(ctrl.getRateIntegral()(0), kIntegralLimit);
+	EXPECT_FLOAT_EQ(ctrl.getRateIntegral()(1), -kIntegralLimit);
+	EXPECT_FLOAT_EQ(ctrl.getRateIntegral()(2), kIntegralLimit);
+	EXPECT_NEAR(torque(0), 1.5f * 20.f / kG1True + kIntegralLimit, 1e-4f);
+}
+
+TEST(IndiRateIntegralTest, CornerIsLimitedToAFifthOfTheRateGain)
+{
+	// a corner of 100 Hz is cut to 0.2 K = 4 rad/s: di/dt = 4 * 20 * 1 / 100 = 0.8 per s
+	IndiRateControl ctrl = makeIntegralController(100.f, 1.f);
+	runRateError(ctrl, 40, false, false, 1.f); // 0.1 s
+	EXPECT_NEAR(ctrl.getRateIntegral()(0), 0.08f, 1e-3f);
+}
+
+TEST(IndiRateIntegralTest, DisabledByZeroCornerOrLimit)
+{
+	for (int variant = 0; variant < 2; variant++) {
+		IndiRateControl ctrl = variant ? makeIntegralController(kIntegralCornerHz, 0.f) : makeIntegralController(0.f, kIntegralLimit);
+		const Vector3f torque = runRateError(ctrl, 400, false, false);
+		EXPECT_EQ(ctrl.getRateIntegral(), Vector3f());
+		EXPECT_NEAR(torque(0), 2.f / kG1True, 1e-6f);
+	}
+}
+
+TEST(IndiRateIntegralTest, RejectedCycleKeepsTheIntegral)
+{
+	IndiRateControl ctrl = makeIntegralController();
+	runRateError(ctrl, 400, false, false);
+	const float held = ctrl.getRateIntegral()(0);
+	ctrl.update(Vector3f(), Vector3f(std::numeric_limits<float>::quiet_NaN(), 0.f, 0.f), Vector3f(), Vector3f(), kDt, false);
+	EXPECT_TRUE(ctrl.getFault());
+	EXPECT_EQ(ctrl.getRateIntegral()(0), held);
+}
